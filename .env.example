# === Database ===
DATABASE_URL=postgresql://username:password@localhost:5432/ngov_db

# === NEAR AI / Inference ===
NEAR_AI_CLOUD_API_KEY=your_near_ai_cloud_api_key_here

# === NEAR Authentication ===
NEAR_RECIPIENT=gov.near

# === Better Auth (wallet linking) ===
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# === Discourse Integration ===
DISCOURSE_URL=https://gov.near.org
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=
DISCOURSE_CLIENT_ID=
DISCOURSE_PLUGIN_URL=

# === Application URLs ===
APP_BASE_URL=https://gov.near.org
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_NEAR_DOMAIN=gov.near.org
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_HARNESS_MODE=auto

# === Verification Helpers ===
VERIFICATION_SERVICE_TOKEN=
INTEL_TDX_ATTESTATION_URL=
INTEL_TDX_API_KEY=

# === Logging & Telemetry ===
# Set to "true" to enable Bun/Next verbose logs
DEBUG=false
# Set to "true" to enable telemetry collection
TELEMETRY_ENABLED=true
# Set to "true" to log telemetry events to console (dev only)
TELEMETRY_DEBUG=false

# === Testing ===
# Set to "true" to use mock verification responses
VERIFY_USE_MOCKS=false
